# Copy to .env and fill in. Never commit .env.

# --- Database (MongoDB via Prisma; also used by the tutor's LangGraph checkpoints)
DATABASE_URL=

# --- Auth (NextAuth + Google OAuth)
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI providers
GEMINI_API_KEY=
# Optional model overrides (see lib/ai/gemini.ts)
GEMINI_MODEL=
GEMINI_AGENT_MODEL=
# OCR for uploaded materials and quiz imports
MISTRAL_API_KEY=
# Visual lesson diagrams and editor AI (Claude)
ANTHROPIC_API_KEY=
# Voice mode (OpenAI Realtime) and editor AI
OPENAI_API_KEY=
# Editor AI provider: openai | anthropic | gemini
NEXT_PUBLIC_AI_PROVIDER=

# --- Vector search (class material embeddings)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- File storage (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# --- Waitlist (Loops)
LOOPS_API_KEY=

# --- Research pipeline (study/) service key; must match study/.env
STUDY_API_KEY=
